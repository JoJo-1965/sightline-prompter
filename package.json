{
	"name": "sightline-prompter",
	"productName": "Sightline Prompter",
	"version": "1.0.5",
	"releaseDate": "2026-10-28",
	"description": "See-through desktop teleprompter for recording to camera. A fork of Electron Teleprompter by David Neal.",
	"main": "src/main.js",
	"type": "module",
	"scripts": {
		"build:editor": "esbuild src/client/editor.js --bundle --format=iife --global-name=EditorModule --outfile=src/client/editor-bundle.js",
		"prestart": "pnpm build:editor",
		"start": "electron .",
		"prebuild": "pnpm build:editor",
		"build": "pnpm dlx @electron/packager --overwrite ./ --out ./dist --ignore=\"/node_modules/\\.ignored\" --ignore=\"/node_modules/(electron|@electron|eslint)\"",
		"lint": "eslint --fix",
		"check-script": "node scripts/check-script.mjs",
		"test": "node scripts/targets.test.mjs && node scripts/fit.test.mjs && node scripts/voice-commands.test.mjs && node scripts/pdf.test.mjs && node scripts/take-log.test.mjs && node scripts/edit-pack.test.mjs && node scripts/version.test.mjs && node scripts/heard-report.test.mjs",
		"dist": "pnpm build:editor && electron-builder --publish never",
		"check-docs": "node scripts/check-docs-sync.mjs"
	},
	"author": "Joanne Lockwood (SEE Change Happen Ltd)",
	"contributors": [
		"David Neal <david@reverentgeek.com> (original Electron Teleprompter)"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/JoJo-1965/sightline-prompter.git"
	},
	"engines": {
		"node": ">=22.16.0"
	},
	"devDependencies": {
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@electron/packager": "^20.3.0",
		"codemirror": "^6.0.2",
		"electron": "45",
		"electron-builder": "25.1.8",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-config-reverentgeek": "^7.1.25"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/opendyslexic": "^5.3.0",
		"chokidar": "6",
		"js-yaml": "^5.5.0",
		"mammoth": "^1.13.0",
		"qrcode": "1.5.4",
		"sherpa-onnx-node": "2.0.1",
		"showdown": "^2.1.0",
		"unpdf": "1.8.1"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"build": {
		"appId": "uk.co.seechangehappen.sightline",
		"productName": "Sightline Prompter",
		"copyright": "© 2022–2026 David Neal and Joanne Lockwood (SEE Change Happen Ltd). MIT licence.",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"files": [
			"src/**/*",
			"docs/guide/**/*",
			"docs/*.md",
			"LICENSE",
			"readme.md",
			"package.json"
		],
		"asarUnpack": [
			"node_modules/sherpa-onnx-*/**"
		],
		"icon": "build/icon.png",
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "Sightline-Prompter-Setup-${version}.${ext}"
		},
		"mac": {
			"target": [
				{
					"target": "dmg"
				}
			],
			"category": "public.app-category.video",
			"identity": null,
			"artifactName": "Sightline-Prompter-${version}-${arch}.${ext}",
			"extendInfo": {
				"NSMicrophoneUsageDescription": "Sightline Prompter listens to you to scroll the script and hear “Prompter, …” commands. Speech is recognised on this Mac."
			}
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "AudioVideo",
			"maintainer": "Joanne Lockwood <jo.lockwood@seechangehappen.co.uk>",
			"artifactName": "Sightline-Prompter-${version}-${arch}.${ext}"
		}
	}
}
